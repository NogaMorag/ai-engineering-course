# Copy this file to ai-course/.env and paste your key. Never commit .env.
# The SDK reads GEMINI_API_KEY (GOOGLE_API_KEY would override it if both exist).
GEMINI_API_KEY=
# Model names live here, not in code. Check https://ai.google.dev/gemini-api/docs/models
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.8-flash
