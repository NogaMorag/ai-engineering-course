# Copy to .env (never committed). The SDK reads GEMINI_API_KEY itself.
GEMINI_API_KEY=your-key-here
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
# Email delivery (optional). Gmail: smtp.gmail.com, 465, an app password (16 chars), your address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
