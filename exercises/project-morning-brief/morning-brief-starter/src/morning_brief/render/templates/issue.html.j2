<!doctype html>
<html lang="{{ issue.language }}" dir="{{ dir }}">
<head><meta charset="utf-8"><title>Morning Brief · {{ issue.date }}</title>
<style>body{font-family:system-ui,sans-serif;max-width:720px;margin:2rem auto;padding:0 1rem;line-height:1.5}h3{margin-bottom:.2rem}.meta{color:#666;font-size:.85rem}.ctx{background:#f6f6f6;padding:.5rem .8rem;border-radius:6px}</style>
</head>
<body>
<h1>Morning Brief · {{ issue.date }}</h1>
<p>{{ issue.greeting_line }}</p>
{% if issue.theme and issue.theme != 'none' %}<p><em>{{ issue.theme }}</em></p>{% endif %}
{% if not issue.top_stories and not issue.more_stories %}<p class="note"><em>No stories today: every source failed or nothing matched your profile. The run report has the details.</em></p>{% endif %}
<h2>Top stories</h2>
{% for item in issue.top_stories %}
<h3>{{ loop.index }}. {{ item.headline }}</h3>
<ul>{% for b in item.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
<p>{{ item.why_it_matters }}</p>
{% if item.research %}<p class="ctx"><strong>Context:</strong> {{ item.research.context }} <strong>Key fact:</strong> {{ item.research.key_fact }}</p>{% endif %}
<p class="meta">Source: <a href="{{ item.url }}">{{ item.source }}</a>{% for c in item.also_covered %} · also covered by <a href="{{ c.url }}">{{ c.source }}</a>{% endfor %}
{% if item.follow_up_of %}<br>Follow-up to a story from {{ item.follow_up_of.day }}: <a href="{{ item.follow_up_of.url }}">earlier coverage</a>{% endif %}</p>
{% endfor %}
<h2>More</h2>
<ul>
{% for item in issue.more_stories %}
<li><strong>{{ item.headline }}</strong> — {{ item.bullets[0] if item.bullets else '' }} <a href="{{ item.url }}">{{ item.source }}</a>{% if item.follow_up_of %} · follow-up{% endif %}</li>
{% endfor %}
</ul>
{% if issue.skipped_note %}<p class="meta"><em>{{ issue.skipped_note }}</em></p>{% endif %}
<hr>
<p class="meta">Generated by Morning Brief · prompt {{ issue.metadata.get('prompt_version', '?') }} · model {{ issue.metadata.get('model_fast', '?') }} · cost ${{ '%.4f' % issue.metadata.get('cost_usd', 0) }}</p>
</body>
</html>
